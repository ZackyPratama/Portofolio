---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  class: className = '',
} = Astro.props;
---

<div
  class:list={[
    'reveal mb-12 border-b-[3px] border-current pb-8',
    className,
  ]}
>
  {
    eyebrow && (
      <p class="mb-4 text-xs font-bold uppercase tracking-[0.3em] text-[#800020] dark:text-white">
        {eyebrow}
      </p>
    )
  }

  <h2
    class="font-heading text-[2.25rem] font-bold leading-[1.05] tracking-tight text-current sm:text-[3.6rem]"
  >
    {title}
  </h2>

  {
    description && (
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-400">
        {description}
      </p>
    )
  }
</div>
