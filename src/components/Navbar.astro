---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '#about', label: 'Tentang' },
  { href: '#skills', label: 'Keahlian' },
  { href: '#projects', label: 'Proyek' },
  { href: '#experience', label: 'Pengalaman' },
  { href: '#contact', label: 'Kontak' },
];
---

<header data-navbar class="fixed inset-x-0 top-0 z-50 px-4 pt-3">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-full border border-slate-200/70 bg-white/70 px-4 py-2 shadow-sm shadow-slate-900/5 backdrop-blur-md transition duration-300 dark:border-white/10 dark:bg-slate-900/60 dark:shadow-black/20"
  >
    <a
      href="#hero"
      class="font-heading text-lg font-bold tracking-tight text-slate-900 dark:text-white"
    >
      Nama<span class="gradient-text">.</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-full px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/5 dark:hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <ThemeToggle />

      <button
        type="button"
        data-menu-toggle
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white/70 text-slate-600 transition hover:border-accent hover:text-accent md:hidden dark:border-white/10 dark:bg-white/5 dark:text-slate-300"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    data-menu
    class="mx-auto mt-2 hidden max-w-6xl rounded-2xl border border-slate-200/70 bg-white/90 p-2 shadow-lg shadow-slate-900/5 backdrop-blur-md md:hidden dark:border-white/10 dark:bg-slate-900/90 dark:shadow-black/30"
  >
    <ul class="flex flex-col">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-xl px-4 py-3 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/5 dark:hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.querySelector('[data-menu-toggle]');
    var menu = document.querySelector('[data-menu]');
    var navbar = document.querySelector('[data-navbar] nav');

    if (toggle && menu) {
      toggle.addEventListener('click', function () {
        var isHidden = menu.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', String(!isHidden));
      });

      menu.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () {
          menu.classList.add('hidden');
          toggle.setAttribute('aria-expanded', 'false');
        });
      });
    }

    if (navbar) {
      var onScroll = function () {
        if (window.scrollY > 8) {
          navbar.classList.add('shadow-md', 'shadow-slate-900/5');
        } else {
          navbar.classList.remove('shadow-md', 'shadow-slate-900/5');
        }
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  })();
</script>
