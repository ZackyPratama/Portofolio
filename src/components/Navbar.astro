---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '#about', label: 'Tentang' },
  { href: '#skills', label: 'Keahlian' },
  { href: '#projects', label: 'Proyek' },
  { href: '#experience', label: 'Pengalaman' },
  { href: '#contact', label: 'Kontak' },
];
---

<noscript><style>[data-navbar]{position:static}[data-menu-toggle]{display:none!important}[data-menu]{display:block!important}</style></noscript>

<header data-navbar class="fixed inset-x-0 top-0 z-50 border-b-[3px] border-black bg-[#f7f4ef] px-4 py-3 dark:border-[#f7f4ef] dark:bg-black">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 bg-transparent px-0 py-1"
  >
    <a
      href="#hero"
      class="font-heading text-xl font-bold tracking-[-0.05em] text-black dark:text-white"
    >
      rnxskyz<span class="gradient-text">.</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
               class="border-[3px] border-transparent px-3 py-2 text-sm font-bold text-black transition hover:border-black hover:bg-[#800020] hover:text-white dark:text-white dark:hover:border-[#f7f4ef]"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <ThemeToggle />

      <button
        type="button"
        data-menu-toggle
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-menu"
         class="inline-flex h-10 w-10 items-center justify-center border-[3px] border-black bg-white text-black transition hover:bg-[#800020] hover:text-white md:hidden dark:border-[#f7f4ef] dark:bg-black dark:text-white"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    data-menu
     class="mx-auto mt-3 max-w-6xl border-[3px] border-black bg-white p-2 shadow-[6px_6px_0_#0a0a0a] md:hidden dark:border-[#f7f4ef] dark:bg-black dark:shadow-[6px_6px_0_#f7f4ef]"
  >
    <ul class="flex flex-col">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
               class="block border-[3px] border-transparent px-4 py-3 text-sm font-bold text-black transition hover:border-black hover:bg-[#800020] hover:text-white dark:text-white dark:hover:border-[#f7f4ef]"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script is:inline>
  (function () {
    const toggle = document.querySelector('[data-menu-toggle]');
    const menu = document.querySelector('[data-menu]');

    if (toggle && menu) {
      menu.classList.add('hidden');
      toggle.addEventListener('click', function () {
        const isHidden = menu.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', String(!isHidden));
        toggle.setAttribute('aria-label', isHidden ? 'Buka menu navigasi' : 'Tutup menu navigasi');
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
          menu.classList.add('hidden');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Buka menu navigasi');
          toggle.focus();
        }
      });

      menu.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () {
          menu.classList.add('hidden');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Buka menu navigasi');
        });
      });
    }

  })();
</script>
