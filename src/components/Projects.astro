---
import SectionTitle from './SectionTitle.astro';
import ProjectsScene from './ProjectsScene.astro';

const projects = [
  {
    title: 'E-Commerce Website PT GMU KARYA TECH',
    description: 'Website E-Commerce dengan 2 model bisnis, yaitu B2B dan B2C. Website ini dibangun menggunakan Laravel, Tailwind CSS, dan Midtrans sebagai payment gateway.',
    tags: ['Laravel', 'Tailwind', 'Midtrans'],
    repo: 'https://github.com/ZackyPratama/E-Commerce-PT-GMU',
  },
];
---

<section id="projects" class="bg-[#F7F4EF] px-6 py-24 text-[#0A0A0A] dark:bg-[#0A0A0A] dark:text-[#F7F4EF] sm:py-28">
  <div class="mx-auto max-w-6xl">
    <SectionTitle eyebrow="03 / Proyek" title="Proyek terpilih" description="Beberapa proyek yang pernah saya kerjakan." />
    <div class="mb-8"><ProjectsScene /></div>
    <div class="grid gap-8 lg:grid-cols-[1.35fr_1fr]">
      {projects.map((project, index) => (
        <article data-project-card data-project={project.title} aria-describedby="project-preview-caption" tabindex="0" class:list={["reveal flex flex-col border-[3px] border-[#0A0A0A] bg-white shadow-[8px_8px_0_#0A0A0A] focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-[#800020] dark:border-[#F7F4EF] dark:bg-[#800020] dark:shadow-[8px_8px_0_#F7F4EF]", index === 0 ? 'lg:row-span-2' : '']}>
          <div class="flex flex-1 flex-col p-6">
            <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-[#800020] dark:text-[#F7F4EF]">{index === 0 ? 'Proyek unggulan' : 'Proyek'}</p>
            <h3 class="font-heading text-2xl font-bold leading-tight">{project.title}</h3>
            <p class="mt-4 flex-1 text-base leading-relaxed">{project.description}</p>
            <div class="mt-6 flex flex-wrap gap-2">{project.tags.map((tag) => <span class="border-2 border-current px-2 py-1 text-xs font-bold">{tag}</span>)}</div>
            {project.repo && <a href={project.repo} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex w-fit border-[3px] border-[#0A0A0A] bg-[#800020] px-4 py-3 text-sm font-bold text-white shadow-[4px_4px_0_#0A0A0A] hover:translate-x-1 hover:translate-y-1 hover:shadow-none focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-[#800020]">Lihat kode</a>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
