---
import SectionTitle from './SectionTitle.astro';

const email = 'rnxskyz@gmail.com';
const socials = [
  { name: 'GitHub', href: 'https://github.com/ZackyPratama/' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/m-zacky-pratama/' },
  { name: 'Instagram', href: 'https://instagram.com/' },
];

const inputClass =
  'w-full border-[3px] border-black bg-white px-4 py-3 text-base text-black outline-none transition placeholder:text-slate-500 focus:-translate-x-1 focus:-translate-y-1 focus:shadow-[5px_5px_0_#800020] dark:border-[#f7f4ef] dark:bg-black dark:text-white dark:placeholder:text-slate-500';
---

<section id="contact" class="relative border-t-[3px] border-black px-6 py-24 dark:border-[#f7f4ef] sm:py-32">
  <div class="mx-auto max-w-6xl">
    <SectionTitle eyebrow="05 / Kontak" title="Mari buat sesuatu." description="Punya pertanyaan atau ingin bekerja sama? Kirim pesan." />

    <div class="grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:items-start">
      <div class="reveal">
        <div class="border-[3px] border-black bg-[#800020] p-6 text-white shadow-[8px_8px_0_#0a0a0a] dark:border-[#f7f4ef] dark:shadow-[8px_8px_0_#f7f4ef]">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-white/75">Status</p>
          <p class="mt-3 font-heading text-3xl font-bold leading-tight">Terbuka untuk kolaborasi.</p>
          <p class="mt-5 text-sm leading-relaxed text-white/85">Saya terbuka untuk peluang kerja, kolaborasi proyek, maupun sekadar berdiskusi.</p>
        </div>

        <div class="mt-8 border-t-[3px] border-black pt-6 dark:border-[#f7f4ef]">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Email</p>
          <a href={`mailto:${email}`} class="mt-2 block break-all font-heading text-xl font-bold text-[#800020] underline decoration-2 underline-offset-4 hover:bg-[#800020] hover:text-white dark:text-white">{email}</a>
        </div>

        <div class="mt-8 border-t-[3px] border-black pt-6 dark:border-[#f7f4ef]">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Lokasi</p>
          <p class="mt-2 font-heading text-xl font-bold text-black dark:text-white">Indonesia</p>
        </div>

        <div class="mt-8">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Temukan saya</p>
          <div class="flex flex-wrap gap-3">
            {socials.map((social) => (
              <a href={social.href} target="_blank" rel="noopener noreferrer" class="border-[3px] border-black bg-white px-4 py-3 text-xs font-bold uppercase tracking-wide text-black shadow-[4px_4px_0_#0a0a0a] transition hover:translate-x-1 hover:translate-y-1 hover:shadow-none dark:border-[#f7f4ef] dark:bg-black dark:text-white dark:shadow-[4px_4px_0_#f7f4ef]">{social.name} ↗</a>
            ))}
          </div>
        </div>
      </div>

      <div class="reveal">
        <form class="border-[3px] border-black bg-white p-6 shadow-[8px_8px_0_#0a0a0a] dark:border-[#f7f4ef] dark:bg-black dark:shadow-[8px_8px_0_#800020]" aria-describedby="contact-form-status">
          <p class="mb-6 text-xs font-bold uppercase tracking-[0.2em] text-[#800020] dark:text-white">Pesan langsung / 01</p>
          <div class="space-y-6">
            <div>
              <label for="name" class="mb-2 block text-sm font-bold uppercase tracking-wide text-black dark:text-white">Nama</label>
              <input id="name" name="name" type="text" required autocomplete="name" placeholder="Nama Anda" class={inputClass} />
            </div>
            <div>
              <label for="email" class="mb-2 block text-sm font-bold uppercase tracking-wide text-black dark:text-white">Email</label>
              <input id="email" name="email" type="email" required autocomplete="email" placeholder="email@contoh.com" class={inputClass} />
            </div>
            <div>
              <label for="message" class="mb-2 block text-sm font-bold uppercase tracking-wide text-black dark:text-white">Pesan</label>
              <textarea id="message" name="message" rows="6" required placeholder="Tulis pesan Anda..." class={inputClass}></textarea>
            </div>
            <div class="border-t-[3px] border-black pt-5 dark:border-[#f7f4ef]">
              <p id="contact-form-status" class="mb-4 text-xs leading-relaxed text-slate-500 dark:text-slate-400">Form belum terhubung ke endpoint pengiriman. Gunakan email di samping untuk menghubungi saya secara langsung.</p>
              <button type="submit" disabled class="w-full border-[3px] border-black bg-[#800020] px-6 py-4 text-sm font-bold uppercase tracking-[0.14em] text-white shadow-[5px_5px_0_#0a0a0a] transition hover:translate-x-1 hover:translate-y-1 hover:shadow-none dark:border-[#f7f4ef] dark:shadow-[5px_5px_0_#f7f4ef]">Form belum aktif</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
