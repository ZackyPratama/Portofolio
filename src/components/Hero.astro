---
import HeroScene from './HeroScene.astro';

const role = 'Full Stack Developer';
---

<section id="hero" class="relative overflow-hidden border-b-[3px] border-black bg-[#f7f4ef] px-6 pb-16 pt-32 dark:border-[#f7f4ef] dark:bg-black sm:pb-24">
  <div class="mx-auto grid min-h-[calc(100vh-5rem)] w-full max-w-6xl items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
    <div>
      <p class="reveal mb-6 inline-block border-[3px] border-black bg-[#800020] px-3 py-2 text-xs font-bold uppercase tracking-[0.22em] text-white dark:border-[#f7f4ef]">Portfolio / 2026</p>
      <h1 class="reveal max-w-4xl font-heading text-[clamp(3.5rem,10vw,8rem)] font-bold uppercase leading-[0.88] tracking-[-0.07em] text-black dark:text-white">M. Zacky <span class="text-[#800020]">Pratama</span></h1>
      <p class="reveal mt-8 border-l-[6px] border-[#800020] pl-4 font-heading text-2xl font-bold uppercase leading-none text-black dark:text-white sm:text-3xl">{role}</p>
      <p class="reveal mt-6 max-w-xl text-base leading-relaxed text-black dark:text-[#f7f4ef] sm:text-lg">Saya adalah Full Stack Developer (Web & Mobile) dengan latar belakang Teknik Informatika. Saya berfokus pada pengembangan sistem yang solid di backend, performa tinggi di frontend, serta merancang aplikasi mobile yang intuitif.</p>
      <div class="reveal mt-10 flex flex-wrap gap-4">
        <a href="#projects" class="border-[3px] border-black bg-[#800020] px-6 py-3 text-sm font-bold text-white shadow-[6px_6px_0_#0a0a0a] transition hover:translate-x-1 hover:translate-y-1 hover:shadow-none dark:border-[#f7f4ef] dark:shadow-[6px_6px_0_#f7f4ef]">Lihat Proyek</a>
        <a href="#contact" class="border-[3px] border-black bg-white px-6 py-3 text-sm font-bold text-black shadow-[6px_6px_0_#0a0a0a] transition hover:translate-x-1 hover:translate-y-1 hover:shadow-none dark:border-[#f7f4ef] dark:bg-black dark:text-white dark:shadow-[6px_6px_0_#f7f4ef]">Hubungi Saya</a>
      </div>
    </div>
    <div class="reveal w-full"><HeroScene /></div>
  </div>
</section>
