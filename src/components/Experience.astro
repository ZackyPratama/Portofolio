---
import SectionTitle from './SectionTitle.astro';


---

<section id="experience" class="relative px-6 pb-24 sm:px-6 sm:pb-32">
  <div class="mx-auto max-w-6xl">
    <SectionTitle
      eyebrow="04 / Pengalaman"
      title="Perjalanan karier"
      description="Detail pengalaman kerja belum tersedia untuk ditampilkan secara terverifikasi."
    />

    <div class="border-[3px] border-black bg-white p-6 text-black shadow-[8px_8px_0_#0a0a0a] dark:border-[#f7f4ef] dark:bg-black dark:text-white dark:shadow-[8px_8px_0_#800020]">
      <p class="font-heading text-xl font-bold uppercase tracking-wide text-[#800020] dark:text-white">Riwayat pengalaman dalam penyusunan</p>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-400">Bagian ini akan diperbarui setelah peran, organisasi, dan periode kerja dikonfirmasi.</p>
    </div>
  </div>
</section>
