---
import SectionTitle from './SectionTitle.astro';

const experiences = [
  {
    period: '2023 — Sekarang',
    role: 'Full Stack Developer',
    company: 'Nama Perusahaan',
    summary:
      'Deskripsi pekerjaan placeholder. Menjelaskan tanggung jawab, kontribusi, dan pencapaian utama.',
    tags: ['Astro', 'React', 'Node.js'],
  },
  {
    period: '2021 — 2023',
    role: 'Frontend Developer',
    company: 'Nama Perusahaan',
    summary:
      'Deskripsi pekerjaan placeholder. Menjelaskan tanggung jawab, kontribusi, dan pencapaian utama.',
    tags: ['Vue', 'Tailwind', 'TypeScript'],
  },
  {
    period: '2020 — 2021',
    role: 'Web Developer Intern',
    company: 'Nama Perusahaan',
    summary:
      'Deskripsi pekerjaan placeholder. Menjelaskan tanggung jawab, kontribusi, dan pencapaian utama.',
    tags: ['HTML', 'CSS', 'JavaScript'],
  },
];
---

<section id="experience" class="relative px-6 pb-24 sm:px-6 sm:pb-32">
  <div class="mx-auto max-w-6xl">
    <SectionTitle
      eyebrow="03 / Pengalaman"
      title="Perjalanan karier"
      description="Jalur eksplorasi: praktik di BPJS, magang di puplas.com, organisasi mahasiswa, dan proyek industri."
    />

    <div class="border-b-[3px] border-black pb-14 dark:border-[#f7f4ef]"></div>
    <ol class="space-y-24">
      {experiences.map((item) => (
        <li class="relative reveal pl-0">
          <div class="grid gap-8 sm:grid-cols-[11rem_1fr] sm:gap-12">
            <div>
              <span class="inline-block border-[3px] border-black bg-white p-4 font-heading text-xs font-bold uppercase tracking-[0.12em] text-[#800020] shadow-[6px_6px_0_#0a0a0a] dark:border-[#f7f4ef] dark:bg-[#f7f4ef] dark:shadow-[6px_6px_0_#800020]">
                {item.period}
              </span>
            </div>

            <div class="glass-card border-[3px] border-black p-6 dark:border-[#f7f4ef] dark:bg-black">
              <p class="font-heading text-1xl font-bold uppercase tracking-wider text-[#800020] dark:text-white">{item.role}</p>
              <p class="font-heading text-sm font-bold uppercase tracking-wider text-white">{item.company}</p>
              <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{item.summary}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <span class="rounded-full border-[3px] border-black bg-white px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-slate-700 dark:border-[#f7f4ef] dark:bg-black dark:text-white">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
