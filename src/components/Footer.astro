---
const year = new Date().getFullYear();

const links = [
  { href: '#about', label: 'Tentang' },
  { href: '#skills', label: 'Keahlian' },
  { href: '#projects', label: 'Proyek' },
  { href: '#experience', label: 'Pengalaman' },
  { href: '#contact', label: 'Kontak' },
];
---

<footer
  class="relative border-t border-slate-200 px-6 py-12 dark:border-white/10"
>
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <a
          href="#hero"
          class="font-heading text-lg font-bold tracking-tight text-slate-900 dark:text-white"
        >
          Nama<span class="gradient-text">.</span>
        </a>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-slate-500 dark:text-slate-400">
          Membangun website yang cepat, rapi, dan nyaman digunakan.
        </p>
      </div>

      <nav aria-label="Navigasi footer">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm font-medium text-slate-600 transition hover:text-accent dark:text-slate-400 dark:hover:text-accent"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-200 pt-6 sm:flex-row dark:border-white/10"
    >
      <p class="text-xs text-slate-500 dark:text-slate-400">
        © {year} Nama Anda. Dibuat dengan Astro &amp; Tailwind CSS.
      </p>

      <a
        href="#hero"
        class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 transition hover:text-accent dark:text-slate-400 dark:hover:text-accent"
      >
        Kembali ke atas
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 19V5M5 12l7-7 7 7" />
        </svg>
      </a>
    </div>
  </div>
</footer>
