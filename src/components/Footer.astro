---
const year = new Date().getFullYear();

const links = [
  { href: '#about', label: 'Tentang' },
  { href: '#skills', label: 'Keahlian' },
  { href: '#projects', label: 'Proyek' },
  { href: '#experience', label: 'Pengalaman' },
  { href: '#contact', label: 'Kontak' },
];
---

<footer class="border-t-[4px] border-black bg-[#800020] px-6 py-12 text-white dark:border-[#f7f4ef]">
  <div class="mx-auto max-w-6xl">
    <a href="#hero" class="font-heading text-[clamp(3.5rem,12vw,9rem)] font-bold leading-none tracking-[-0.07em] text-white hover:underline">
      rnxskyz.
    </a>

    <div class="mt-10 grid gap-8 border-t-[3px] border-white pt-8 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="max-w-md text-base leading-relaxed text-white/85">Membangun website yang cepat, rapi, dan nyaman digunakan.</p>
        <p class="mt-5 text-xs font-bold uppercase tracking-[0.18em] text-white/75">© {year} rnxskyz / Astro &amp; Tailwind CSS</p>
      </div>

      <nav aria-label="Navigasi footer">
        <ul class="flex flex-wrap gap-x-5 gap-y-3 md:max-w-md md:justify-end">
          {links.map((link) => (
            <li><a href={link.href} class="text-sm font-bold uppercase tracking-wide text-white underline-offset-4 hover:underline">{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <a href="#hero" class="mt-10 inline-flex border-[3px] border-white bg-black px-5 py-3 text-xs font-bold uppercase tracking-[0.18em] text-white shadow-[5px_5px_0_#ffffff] transition duration-150 hover:translate-x-1 hover:translate-y-1 hover:shadow-none">
      Kembali ke atas ↑
    </a>
  </div>
</footer>
